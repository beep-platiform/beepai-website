{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "rewrites": [{ "source": "/((?!robots.txt|sitemap.xml).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Cache-Control", "value": "private, no-store" }] }]
}
